generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "views"]
}

generator prismabox {
  provider                    = "prismabox"
  previewFeatures             = ["partialIndexes"]
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  schemas  = ["3nconnect"]
}

