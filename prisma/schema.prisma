generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes", "views"]
}

generator prismabox {
  provider                    = "prismabox"
  previewFeatures             = ["partialIndexes"]
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  schemas  = ["3nconnect"]
}

model attribute_groups {
  id                     Int          @id @default(autoincrement())
  attr_group_name        String?
  attr_group_description String?
  is_active              Boolean?
  created_at             DateTime     @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?    @db.Timestamptz(6)
  attributes             attributes[]

  @@schema("3nconnect")
}

model attributes {
  id               Int               @id @default(autoincrement())
  attr_group_id    Int?
  attr_name        String?
  attr_description String?
  is_active        Boolean?
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?         @db.Timestamptz(6)
  attribute_groups attribute_groups? @relation(fields: [attr_group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model brands {
  id          Int        @id @default(autoincrement())
  brand_image String?
  url_image   String?
  brand_name  String
  country_id  Int?
  is_active   Boolean
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @db.Timestamptz(6)
  products    products[]

  @@schema("3nconnect")
}

model cart_reviews {
  id                           Int       @id @default(autoincrement())
  review_token                 String?
  expires_at                   DateTime? @db.Timestamptz(6)
  requires_sign_in_for_voucher Boolean?  @default(true)
  requires_sign_in_for_payment Boolean?  @default(true)
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  customeruser_id              String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@schema("3nconnect")
}

model companies {
  id            Int             @id @default(autoincrement())
  company_image String?
  url_image     String?
  company_name  String?
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?       @db.Timestamptz(6)
  is_active     Boolean
  order_billing order_billing[]
  products      products[]

  @@schema("3nconnect")
}

model countries {
  id           Int       @id @default(autoincrement())
  country_name String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  is_active    Boolean?
  short_name   String?

  @@schema("3nconnect")
}

model customer_address {
  id              Int      @id @default(autoincrement())
  customeruser_id String?  @db.Uuid
  tag_name        String?
  receiver_name   String?
  phone_no        String?
  address_name    String?
  address_line1   String?
  address_line2   String?
  sub_district    String?
  district        String?
  province        String?
  post_code       String?
  set_default     Boolean?

  @@schema("3nconnect")
}

model customer_redeem_code {
  id              Int       @id @default(autoincrement())
  customeruser_id String?   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  gift_voucher_id Int?
  used_at         DateTime? @db.Timestamptz(6)

  @@schema("3nconnect")
}

model event_categories {
  id              Int       @id @default(autoincrement())
  event_cate_name String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)
  is_active       Boolean?
  events          events[]

  @@schema("3nconnect")
}

model events {
  id                Int               @id @default(autoincrement())
  event_name        String?
  event_detail      String?
  register_date     DateTime?         @db.Date
  preregister_date  DateTime?         @db.Date
  event_startdate   DateTime?         @db.Date
  event_enddate     DateTime?         @db.Date
  event_image       String?
  location_name     String?
  event_category_id Int?
  tier_register     String[]
  tier_preregister  String[]
  ref_url           String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @db.Timestamptz(6)
  is_active         Boolean?
  event_categories  event_categories? @relation(fields: [event_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("3nconnect")
}

model gift_voucher {
  id                            Int                             @id @default(autoincrement())
  url_image                     String?
  voucher_image                 String?
  voucher_name                  String?
  voucher_description           String?
  voucher_conditions            String?
  campaign_start                DateTime?                       @db.Timestamptz(6)
  campaign_end                  DateTime?                       @db.Timestamptz(6)
  customer_tiers                String[]
  specific_customers            String[]
  is_accept_overlapse_promotion Boolean?
  is_limit_voucher              Boolean?
  is_specific_customers         Boolean?
  is_active                     Boolean?
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?                       @db.Timestamptz(6)
  gift_voucher_type             String?                         @default("")
  gift_voucher_method           String?
  voucher_uuid                  String                          @db.Uuid
  limited_total_quantity        Int?
  is_lifetime_period            Boolean?
  usage_period_day              Int?
  event_trigger                 String?
  tier_trigger_name             String?
  gift_voucher_campaign_voucher gift_voucher_campaign_voucher[]
  gift_voucher_generic          gift_voucher_generic[]
  gift_voucher_redeem_code      gift_voucher_redeem_code[]

  @@schema("3nconnect")
}

model gift_voucher_campaign_voucher {
  id                 Int           @id(map: "gift_voucher_event_pkey") @default(autoincrement())
  gift_voucher_id    Int?
  generic_voucher_id Int?
  gift_voucher       gift_voucher? @relation(fields: [gift_voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model gift_voucher_generic {
  id               Int           @id @default(autoincrement())
  gift_voucher_id  Int?
  discount_type    String?
  min_purchase     Float?
  percent_discount Float?
  max_discount     Float?
  usage_period_day Int?
  gift_voucher     gift_voucher? @relation(fields: [gift_voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model gift_voucher_redeem_code {
  id                     Int           @id @default(autoincrement())
  gift_voucher_id        Int?
  redeem_code            String?
  max_discount           Float?
  max_usage_per_customer Int?
  gift_voucher           gift_voucher? @relation(fields: [gift_voucher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model product_categories {
  id                       String               @id(map: "categories_pkey")
  name                     String
  slug                     String               @unique(map: "categories_slug_unique")
  parent_id                String?
  ancestors                String[]             @default([])
  level                    Int                  @default(0) @db.SmallInt
  sort_order               Int                  @default(0) @db.SmallInt
  image_url                String?
  is_active                Boolean              @default(true)
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?            @db.Timestamptz(6)
  product_categories       product_categories?  @relation("product_categoriesToproduct_categories", fields: [parent_id], references: [id], onUpdate: NoAction, map: "categories_parent_id_fkey")
  other_product_categories product_categories[] @relation("product_categoriesToproduct_categories")
  products                 products[]

  @@index([ancestors], map: "idx_categories_ancestors", type: Gin)
  @@index([is_active], map: "idx_categories_is_active")
  @@index([level], map: "idx_categories_level")
  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([sort_order], map: "idx_categories_sort_order")
  @@schema("3nconnect")
}

model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int?
  url_image  String?
  is_show    Boolean?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model product_options {
  id                   Int       @id @default(autoincrement())
  product_id           Int?
  mat_identity         String?
  option_name          String?
  online_price         Float?
  min_price            Float?
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  row_no               Int?
  updated_at           DateTime? @db.Timestamptz(6)
  is_stock             Boolean?
  attributes_hierarchy Int[]
  products             products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model product_payment_method {
  id                Int       @id @default(autoincrement())
  product_id        Int?
  qr_code_promptpay Boolean?
  visa_card         Boolean?
  mobile_banking    Boolean?
  credit_terms      Boolean?
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)
  products          products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

model products {
  id                     Int                      @id @default(autoincrement())
  product_name           String?
  product_description    String?
  company_id             Int?
  brand_id               Int?
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime?                @db.Timestamptz(6)
  is_active              Boolean?
  category_hierarchy     String[]
  unit                   String?
  is_online_active       Boolean?
  category_id            String?
  video_product          String?
  condition_description  String?
  warranty_description   String?
  youtube_url            String?
  is_pre_order           Boolean?
  is_custom_options      Boolean?
  product_images         product_images[]
  product_options        product_options[]
  product_payment_method product_payment_method[]
  brands                 brands?                  @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_categories     product_categories?      @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies              companies?               @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("3nconnect")
}

