generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

generator prismabox {
  provider                    = "prismabox"
  previewFeatures             = ["partialIndexes"]
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  schemas  = ["3nconnect"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brands {
  id          Int        @id @default(autoincrement())
  brand_image String?
  url_image   String?
  brand_name  String
  country_id  Int?
  is_active   Boolean
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @db.Timestamptz(6)
  products    products[]

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  id            Int        @id @default(autoincrement())
  company_image String?
  url_image     String?
  company_name  String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @db.Timestamptz(6)
  is_active     Boolean
  products      products[]

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model countries {
  id           Int       @id @default(autoincrement())
  country_name String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  is_active    Boolean?
  short_name   String?

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                  Int                 @id @default(autoincrement())
  product_name        String?
  product_description String?
  mat_identity        String?
  company_id          Int?
  brand_id            Int?
  min_price           Float?
  online_price        Float?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?           @db.Timestamptz(6)
  is_active           Boolean?
  category_hierarchy  String[]
  mat_unit_identity   String?
  unit                String?
  is_online_active    Boolean?
  category_id         String?
  product_images      product_images[]
  brands              brands?             @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  categories          product_categories? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies           companies?          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_images {
  id         Int       @id @default(autoincrement())
  product_id Int?
  url_image  String?
  is_show    Boolean?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  products   products? @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model event_categories {
  id              Int       @id @default(autoincrement())
  event_cate_name String?
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @db.Timestamptz(6)
  is_active       Boolean?
  events          events[]

  @@schema("3nconnect")
}

model product_categories {
  id                       String               @id(map: "categories_pkey")
  name                     String
  slug                     String               @unique(map: "categories_slug_unique")
  parent_id                String?
  ancestors                String[]             @default([])
  level                    Int                  @default(0) @db.SmallInt
  sort_order               Int                  @default(0) @db.SmallInt
  image_url                String?
  is_active                Boolean              @default(true)
  created_at               DateTime             @default(now()) @db.Timestamptz(6)
  updated_at               DateTime?            @db.Timestamptz(6)
  product_categories       product_categories?  @relation("product_categoriesToproduct_categories", fields: [parent_id], references: [id], onUpdate: NoAction, map: "categories_parent_id_fkey")
  other_product_categories product_categories[] @relation("product_categoriesToproduct_categories")
  products                 products[]

  @@index([ancestors], map: "idx_categories_ancestors", type: Gin)
  @@index([is_active], map: "idx_categories_is_active")
  @@index([level], map: "idx_categories_level")
  @@index([parent_id], map: "idx_categories_parent_id")
  @@index([sort_order], map: "idx_categories_sort_order")
  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model events {
  id                Int               @id @default(autoincrement())
  event_name        String?
  event_detail      String?
  register_date     DateTime?         @db.Date
  preregister_date  DateTime?         @db.Date
  event_startdate   DateTime?         @db.Date
  event_enddate     DateTime?         @db.Date
  event_image       String?
  location_name     String?
  event_category_id Int?
  tier_register     String[]
  tier_preregister  String[]
  ref_url           String?
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?         @db.Timestamptz(6)
  is_active         Boolean?
  event_categories  event_categories? @relation(fields: [event_category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("3nconnect")
}
