generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

generator prismabox {
  provider                    = "prismabox"
  previewFeatures             = ["partialIndexes"]
  inputModel                  = "true"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
}

datasource db {
  provider = "postgresql"
  schemas  = ["3nconnect"]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brands {
  id          Int        @id @default(autoincrement())
  brand_image String?
  url_image   String?
  brand_name  String
  country_id  Int?
  is_active   Boolean
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?  @db.Timestamptz(6)
  products    products[]

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model companies {
  id            Int        @id @default(autoincrement())
  company_image String?
  url_image     String?
  company_name  String?
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?  @db.Timestamptz(6)
  is_active     Boolean
  products      products[]

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model countries {
  id           Int       @id @default(autoincrement())
  flag_image   String?
  url_image    String?
  country_name String?
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @db.Timestamptz(6)
  is_active    Boolean?

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_type_one {
  id               Int                @id(map: "product_type_pkey") @default(autoincrement())
  type_name        String?
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?          @db.Timestamptz(6)
  is_active        Boolean
  product_type_two product_type_two[]
  products         products[]

  @@schema("3nconnect")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_type_three {
  id                  Int              @id(map: "product_type_three_duplicate_pkey") @default(autoincrement())
  type_name           String?
  created_at          DateTime         @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?        @db.Timestamptz(6)
  is_active           Boolean
  product_type_two_id Int
  product_type_two    product_type_two @relation(fields: [product_type_two_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products[]

  @@schema("3nconnect")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_type_two {
  id                  Int                  @id @default(autoincrement())
  type_name           String?
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?            @db.Timestamptz(6)
  is_active           Boolean
  product_type_one_id Int
  product_type_three  product_type_three[]
  product_type_one    product_type_one     @relation(fields: [product_type_one_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  products            products[]

  @@schema("3nconnect")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id                    Int                 @id @default(autoincrement())
  product_name          String?
  product_description   String?
  mat_identity          String?
  company_id            Int?
  brand_id              Int?
  min_price             Float?
  online_price          Float?
  product_type_one_id   Int?
  product_type_two_id   Int?
  product_type_three_id Int?
  created_at            DateTime            @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?           @db.Timestamptz(6)
  is_active             Boolean?
  brands                brands?             @relation(fields: [brand_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companies             companies?          @relation(fields: [company_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_type_one      product_type_one?   @relation(fields: [product_type_one_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_type_three    product_type_three? @relation(fields: [product_type_three_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product_type_two      product_type_two?   @relation(fields: [product_type_two_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@schema("3nconnect")
}
